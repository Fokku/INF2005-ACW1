# ---- Secrets: never commit private keys (demo-only keys live in keys/private, ignored) ----
keys/private/
*.pem
!keys/public/*.pem
*.key
.env
.env.*

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# ---- Node / Vite ----
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*

# ---- Editors / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# ---- Scratch outputs (keep curated samples/evidence tracked) ----
tmp/
out/

# ---- Build output ----
# Never committed. scripts/package_submission.sh builds the UI and puts that
# fresh frontend/dist in the submission archive, so the marker needs only Python.
frontend/dist/

# ---- Submission archive (scripts/package_submission.sh) ----
/dist/
